package pages

import (
	"fmt"
	"regexp"
	"strings"
	"thundercitizen/internal/transit"
	"thundercitizen/templates"
	"thundercitizen/templates/components"
)

// sundayScheduleNotice matches the upstream "Sunday schedules are
// available at thunderbay.ca/transit" sentence (with optional trailing
// punctuation) so we can drop it from the holiday banner — it points
// users off-site for info we already render.
var sundayScheduleNotice = regexp.MustCompile(`(?i)\s*Sunday schedules are available at thunderbay\.ca/transit\.?`)

func pillBorderStyle(color string) templ.Attributes {
	return templ.Attributes{"style": "border-left-color:" + color}
}

func pillIdStyle(bg string) templ.Attributes {
	return templ.Attributes{"style": "background:" + bg}
}

func alertRouteStyle(meta []transit.RouteMetaAPI, routeID string) templ.Attributes {
	for _, r := range meta {
		if r.RouteID == routeID && r.Color != "" {
			return templ.Attributes{"style": "background:" + r.Color}
		}
	}
	return templ.Attributes{}
}

// routeCancelSplit returns (past, upcoming) cancellation counts for one
// route. Mirrors the JS in transit-map.ts so server-rendered pills match
// the JS-rebuilt pills on first paint.
func routeCancelSplit(trips map[string][]transit.CancelledTrip, routeID string) (past, upcoming int) {
	for _, t := range trips[routeID] {
		if t.Upcoming {
			upcoming++
		} else {
			past++
		}
	}
	return
}

// cleanAlertText normalizes upstream alert description text for the
// compact banner: collapses CRLF / multiple whitespace runs into single
// spaces so trip-list-style descriptions don't blow out the row height.
func cleanAlertText(s string) string {
	s = strings.ReplaceAll(s, "\r\n", " ")
	s = strings.ReplaceAll(s, "\n", " ")
	s = sundayScheduleNotice.ReplaceAllString(s, "")
	return strings.Join(strings.Fields(s), " ")
}

// alertSegment is one piece of an alert description, optionally a link.
// Links are only emitted for recognised first-party URLs so we never
// inject markup from arbitrary upstream feed text.
type alertSegment struct {
	Text string
	Href string // empty for plain text
}

// alertLinks maps the bare URL substrings we recognise in upstream alert
// descriptions to safe destinations on our own site. Anything not in this
// table renders as plain text — we don't try to autolink arbitrary URLs
// from the feed.
var alertLinks = []struct {
	Needle string
	Href   string
}{
	{"thunderbay.ca/transit", "/transit"},
}

func segmentAlertText(s string) []alertSegment {
	s = cleanAlertText(s)
	for _, l := range alertLinks {
		if i := strings.Index(s, l.Needle); i >= 0 {
			return []alertSegment{
				{Text: s[:i]},
				{Text: l.Needle, Href: l.Href},
				{Text: s[i+len(l.Needle):]},
			}
		}
	}
	return []alertSegment{{Text: s}}
}

func hasRoute(ids []string, id string) bool {
	for _, x := range ids {
		if x == id {
			return true
		}
	}
	return false
}

func ftCellClass(active bool, kind string) string {
	if active {
		return "route-pill-ft " + kind
	}
	return "route-pill-ft"
}

func transitLayerGroups() []components.MapLayerGroup {
	return []components.MapLayerGroup{{
		Label: "Layers",
		Layers: []components.MapLayer{
			{Key: "buses", Label: "Buses", Active: true, Icon: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="14" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="7" cy="21" r="1.5"/><circle cx="17" cy="21" r="1.5"/></svg>`},
			{Key: "network", Label: "Routes", Active: true, Icon: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="3"/><circle cx="19" cy="18" r="3"/><path d="M8 6h4a4 4 0 0 1 4 4v4"/></svg>`},
			{Key: "timepoints", Label: "Time Points", Active: false, Icon: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`},
		},
	}}
}

templ TransitLive(vm transit.LiveViewModel) {
	@templates.Layout(templates.SocialMeta{
		Title:       "Transit",
		Description: "Live Thunder Bay Transit map — real-time bus positions, service alerts, cancellations, and stop-to-stop trip planning.",
		OGImage:     "/static/og/transit.png",
	}) {
		@components.TransitNav(components.TransitNavProps{Current: "map"})

		<h1 class="sr-only">Live Transit</h1>
		<section class="route-panel" aria-label="Live transit map and routes">
			if len(vm.Alerts) > 0 {
				<section aria-label="Service alerts" class="transit-alerts">
					for _, a := range vm.Alerts {
						if a.Header != nil || a.Description != nil {
							<article class="transit-alert">
								<svg class="transit-alert-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
								<span class="transit-alert-body">
									if a.Header != nil {
										<strong>{ *a.Header }</strong>
									}
									if a.Description != nil {
										for _, seg := range segmentAlertText(*a.Description) {
											if seg.Href != "" {
												<a href={ templ.SafeURL(seg.Href) }>{ seg.Text }</a>
											} else {
												{ seg.Text }
											}
										}
									}
								</span>
								if len(a.AffectedRoutes) > 0 {
									<span class="transit-alert-routes">
										for _, rid := range a.AffectedRoutes {
											<span class="transit-alert-route-pill" { alertRouteStyle(vm.RouteMeta, rid)... }>{ rid }</span>
										}
									</span>
								}
							</article>
						}
					}
				</section>
			}
			<div class="terminal-map-header" id="map-info-host">
				<span class="transit-status-cell">
					<span id="transit-status" class="transit-status transit-status-off" role="status" aria-live="polite">Live</span>
				</span>
				<div id="selector-bar">
					@components.MapLayerBar(transitLayerGroups())
				</div>
				<div class="selector-bar">
					<span class="selector-bar-label">Features</span>
					<div class="selector-bar-btns">
						<button type="button" id="map-locate-btn" class="selector-bar-btn" title="Show my location" aria-label="Show my location">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
							<span>Locate</span>
						</button>
						<button type="button" id="find-route-btn" class="selector-bar-btn trip-planner-open" aria-controls="trip-planner" aria-expanded="false">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
							<span>Find Route</span>
						</button>
					</div>
				</div>
				<div class="tmi-layer tmi-hover" data-layer="hover" aria-live="polite"></div>
				<div class="tmi-layer tmi-selection" data-layer="selection" aria-live="polite"></div>
				<div class="tmi-layer tmi-trip" data-layer="trip" aria-live="polite"></div>
			</div>
				@templ.JSONScript("route-meta", vm.RouteMeta)
			@components.LeafletMap(components.MapProps{
				ID:        "transit-map",
				AriaLabel: "Live map showing Thunder Bay bus positions. Bus locations update every 10 seconds.",
				Class:     "transit-map-wrap",
				Scripts:   []string{"/static/transit/route-meta.js", "/static/transit/transit-map.js"},
			}) {
				<div id="trip-planner" class="trip-planner trip-planner-overlay">
					<button type="button" id="trip-planner-close" class="trip-planner-tab" aria-label="Close route finder">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
						Close
					</button>
					<div id="trip-planner-body" class="trip-planner-body">
						<div class="trip-planner-form">
							<div class="trip-field">
								<label for="trip-from" class="trip-label">From</label>
								<div class="trip-search-wrap">
									<input id="trip-from" type="search" inputmode="search" name="trip-from-stop-search" placeholder="Stop or number" autocomplete="off" autocorrect="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-controls="trip-from-results" aria-expanded="false"/>
									<div id="trip-from-results" class="trip-search-results" role="listbox" aria-label="From stop suggestions" hidden></div>
								</div>
							</div>
							<div class="trip-field">
								<label for="trip-to" class="trip-label">To</label>
								<div class="trip-search-wrap">
									<input id="trip-to" type="search" inputmode="search" name="trip-to-stop-search" placeholder="Stop or number" autocomplete="off" autocorrect="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-controls="trip-to-results" aria-expanded="false"/>
									<div id="trip-to-results" class="trip-search-results" role="listbox" aria-label="To stop suggestions" hidden></div>
								</div>
							</div>
						</div>
						<input type="hidden" name="from_lat" id="trip-from-lat"/>
						<input type="hidden" name="from_lon" id="trip-from-lon"/>
						<input type="hidden" name="from_stop" id="trip-from-stop"/>
						<input type="hidden" name="to_lat" id="trip-to-lat"/>
						<input type="hidden" name="to_lon" id="trip-to-lon"/>
						<input type="hidden" name="to_stop" id="trip-to-stop"/>
						<input type="hidden" name="partial" value="plan"/>
						<div id="trip-planner-intro" class="trip-planner-intro">
							<p class="trip-planner-note">Finds routes through the bus network assuming at most a 400m walk.</p>
							<p class="trip-planner-note">We'll pre-populate a Google link for your convenience.</p>
						</div>
						<div id="trip-results" class="trip-results" aria-live="polite" aria-atomic="false"></div>
					</div>
				</div>
			}
			<input type="radio" name="term-tab" id="term-tab-routes" class="terminal-tab-radio" checked aria-hidden="true" tabindex="-1"/>
			<input type="radio" name="term-tab" id="term-tab-buses" class="terminal-tab-radio" aria-hidden="true" tabindex="-1"/>
			<input type="radio" name="term-tab" id="term-tab-cancels" class="terminal-tab-radio" aria-hidden="true" tabindex="-1"/>
			<div class="terminal-header">
				<div class="terminal-clock">
					<span class="terminal-city">Thunder Bay — <span id="terminal-date">{ vm.ClockDate }</span></span>
					<span class="terminal-clock-row">
						<span id="terminal-time" class="terminal-time">{ vm.ClockTime }</span>
					</span>
				</div>
				<div class="terminal-tabs" role="tablist" aria-label="Terminal sections">
					<span class="terminal-tabs-label" aria-hidden="true">Info:</span>
					<div class="terminal-tab-group">
						<label for="term-tab-routes" class="terminal-tab-label" role="tab" id="tab-routes" aria-selected="true" tabindex="0" aria-controls="panel-routes">Routes</label>
						<label for="term-tab-buses" class="terminal-tab-label" role="tab" id="tab-buses" aria-selected="false" tabindex="-1" aria-controls="panel-buses">
							<span id="terminal-bus-count" class="terminal-badge-num">{ fmt.Sprintf("%d", vm.BusCount) }</span> Buses
						</label>
						<label for="term-tab-cancels" class="terminal-tab-label" role="tab" id="tab-cancels" aria-selected="false" tabindex="-1" aria-controls="panel-cancels">
							<span id="terminal-cancel-count" class="terminal-badge-num">{ fmt.Sprintf("%d", upcomingCancellationCount(vm.CancelledTrips) + pastCancellationCount(vm.CancelledTrips)) }</span>
							if upcomingCancellationCount(vm.CancelledTrips) > 0 {
								<span class="terminal-cancels-upcoming">({ fmt.Sprintf("%d", upcomingCancellationCount(vm.CancelledTrips)) })</span>
							}
							Cancelled
						</label>
					</div>
				</div>
			</div>
			<div class="terminal-tab-panels">
				<div class="terminal-tab-panel" id="panel-routes" role="tabpanel" aria-labelledby="tab-routes" tabindex="0">
					<div class="route-legend-bar">
						<div id="route-grid" class="route-legend" role="list" aria-label="Bus routes — click to filter map">
							for _, rt := range vm.RouteMeta {
								{{ pastN, upcomingN := routeCancelSplit(vm.CancelledTrips, rt.RouteID) }}
								{{ noService := hasRoute(vm.NoServiceRoutes, rt.RouteID) }}
								<button type="button" class="route-pill route-pill-inactive" role="listitem" data-route={ rt.RouteID } { pillBorderStyle(rt.Color)... }>
									<span class="route-pill-id" { pillIdStyle(rt.Color)... }>{ rt.RouteID }</span>
									if rt.Name != "" && rt.Name != rt.RouteID {
										<span class="route-pill-name">{ rt.Name }</span>
									}
									if noService {
										<span class="route-pill-no-service">No Service</span>
									} else if len(rt.Terminals) > 0 {
										<span class="route-pill-term-from">{ rt.Terminals[0] }</span>
										if len(rt.Terminals) > 1 && rt.Terminals[1] != rt.Terminals[0] {
											<span class="route-pill-term-to">{ rt.Terminals[1] }</span>
										}
									}
									<span class="route-pill-footer">
										<span class="route-pill-ft"><span class="route-pill-ft-val">0</span><span class="route-pill-ft-label">buses</span></span>
										<span class="route-pill-ft-sep"></span>
										if pastN > 0 {
											<span class={ ftCellClass(true, "ft-error") } data-cancel-route={ rt.RouteID }><span class="route-pill-ft-val">{ fmt.Sprintf("%d", pastN) }</span><span class="route-pill-ft-label">cancel</span></span>
										} else {
											<span class="route-pill-ft"><span class="route-pill-ft-val">0</span><span class="route-pill-ft-label">cancel</span></span>
										}
										<span class="route-pill-ft-sep"></span>
										if upcomingN > 0 {
											<span class={ ftCellClass(true, "ft-warn") } data-cancel-route={ rt.RouteID }><span class="route-pill-ft-val">{ fmt.Sprintf("%d", upcomingN) }</span><span class="route-pill-ft-label">upcoming</span></span>
										} else {
											<span class="route-pill-ft"><span class="route-pill-ft-val">0</span><span class="route-pill-ft-label">upcoming</span></span>
										}
									</span>
								</button>
							}
						</div>
					</div>
					<div id="route-schedule-inline" class="route-schedule-inline" hidden></div>
				</div>
				<div class="terminal-tab-panel" id="panel-buses" role="tabpanel" aria-labelledby="tab-buses" tabindex="0">
					<div id="terminal-buses-list" class="terminal-panel-list"></div>
				</div>
				<div class="terminal-tab-panel" id="panel-cancels" role="tabpanel" aria-labelledby="tab-cancels" tabindex="0">
					<div id="terminal-cancels-list" class="terminal-panel-list"></div>
				</div>
			</div>
		</section>
		@terminalTabKeyboard()

		<div id="cancelled-routes-data" data-routes={ strings.Join(vm.CancelledRoutes, ",") } hidden></div>
		<div id="no-service-routes-data" data-routes={ strings.Join(vm.NoServiceRoutes, ",") } hidden></div>
		if len(vm.CancelledTrips) > 0 {
			@templ.JSONScript("cancelled-trips-data", vm.CancelledTrips)
		}
		if len(vm.StopAlerts) > 0 {
			@templ.JSONScript("stop-alerts-data", vm.StopAlerts)
		}
	}
}

templ terminalTabKeyboard() {
	<script>
	(function() {
		var tablist = document.querySelector('.terminal-tabs[role="tablist"]');
		if (!tablist) return;
		var tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
		var radios = Array.from(document.querySelectorAll('.terminal-tab-radio'));

		function syncAria() {
			tabs.forEach(function(tab) {
				var radioId = tab.getAttribute('for');
				var radio = document.getElementById(radioId);
				var isActive = radio && radio.checked;
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
				tab.setAttribute('tabindex', isActive ? '0' : '-1');
			});
		}

		radios.forEach(function(r) {
			r.addEventListener('change', syncAria);
		});

		tablist.addEventListener('keydown', function(e) {
			var idx = tabs.indexOf(e.target);
			if (idx < 0) return;
			var next = -1;
			if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
				next = (idx + 1) % tabs.length;
			} else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
				next = (idx - 1 + tabs.length) % tabs.length;
			} else if (e.key === 'Home') {
				next = 0;
			} else if (e.key === 'End') {
				next = tabs.length - 1;
			}
			if (next >= 0) {
				e.preventDefault();
				tabs[next].focus();
				tabs[next].click();
			}
		});

		syncAria();
	})();
	</script>
}
