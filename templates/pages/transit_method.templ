package pages

import (
	"thundercitizen/internal/transit"
	"thundercitizen/templates"
	"thundercitizen/templates/components"
)

templ TransitMethod(vm transit.MethodViewModel) {
	@templates.Layout(templates.SocialMeta{
		Title:       "Transit — Method",
		Description: "How transit punctuality, reported cancellations and headway reliability are measured, and what missing observations mean.",
		OGImage:     "/static/og/transit.png",
	}) {
		@components.TransitNav(components.TransitNavProps{Current: "method"})
		@components.PageHeader(components.PageHeaderProps{Title: "Transit Method"})
		<section class="report-methodology" aria-label="Measurement methods">
			<article id="downloads">
				<header class="methods-header"><h3>Download reports</h3></header>
				<p>One ZIP contains monthly metrics and daily route summaries for the trailing 12 completed months. The current month is excluded.</p>
				if vm.ReportURL != "" {
					<p><a href={ templ.SafeURL(vm.ReportURL) }>Download transit reports (ZIP)</a></p>
				} else {
					<p>Reports will appear here once published.</p>
				}
				<p>Blank values mean unavailable. Raw observations and timetables are archived separately.</p>
			</article>
			<article>
				<header class="methods-header"><h3>What the numbers mean</h3></header>
				<dl>
					<dt><strong>On-time performance (OTP)</strong></dt>
					<dd>The share of reported timepoint departures between one minute early and five minutes late. Each observation counts separately; final destinations are excluded. Feed delays may be predictions, not confirmed departures.</dd>
					<dt><strong>Reported cancellations</strong></dt>
					<dd>Distinct cancelled trips divided by scheduled trips. Missing GPS alone does not count as a cancellation. Short notice means reported less than 15 minutes before departure, including after departure.</dd>
					<dt><strong>Excess waiting time</strong></dt>
					<dd>Observed wait minus scheduled wait, in minutes, for someone arriving at random. Both use the same observation interval. Negative values mean a shorter wait than scheduled. This is most useful for frequent service.</dd>
					<dt><strong>Bus spacing (headway CV)</strong></dt>
					<dd>Variation in the gaps between buses: standard deviation divided by mean gap. Lower means more even spacing. Even spacing alone does not mean buses are on time or all trips ran.</dd>
				</dl>
			</article>
			<article>
				<header class="methods-header"><h3>Coverage matters</h3></header>
				<p>These are unofficial estimates from Thunder Bay Transit's public feeds. Missing data stays unavailable, never zero. Changes in coverage can affect comparisons.</p>
				<p>Waiting-time and spacing measures require every scheduled passage in a window to be observed or reported cancelled. Incomplete windows are excluded.</p>
				<details>
					<summary>How observations are checked</summary>
					<p>GPS segments must pass within 35 metres of a stop, with supporting stop status or progression. We reject segments over 30 seconds or 35 metres per second, terminals, endpoints, repeated or ambiguous stops, vehicle changes and backwards stop order.</p>
					<p>Older GPS records use feed timestamps. These checks cannot guarantee timing accuracy, and the remaining observations may not represent all service.</p>
				</details>
			</article>
			<article>
				<header class="methods-header"><h3>Reading trends</h3></header>
				<p>The light line shows daily values; the heavier line recomputes a 30-day trend from counts and observation windows. It needs at least 70% of the selected day type and a reading on the final day.</p>
				<p>Compare the same route and check coverage. Timetable changes and seasonality can affect results; these trends are not seasonally adjusted.</p>
				<details>
					<summary>How results are combined</summary>
					<p>Waiting-time and spacing windows are calculated separately by stop, direction, day and time band. Route results are weighted by window duration; system results give each contributing route equal weight. We have no passenger counts.</p>
					<p>The trend covers service from 6 a.m. to midnight and excludes the unfinished service day. Percentages are recomputed from their counts, not averaged across days.</p>
				</details>
			</article>
			<article>
				<header class="methods-header"><h3>Sources and service days</h3></header>
				<p>Service day: 4 a.m. to 4 a.m. Eastern Time.</p>
				<p>Public <a href="https://gtfs.org/documentation/schedule/reference/">GTFS feeds</a> supply timetables and updates. We poll positions every { vm.VehiclePoll }, trip updates every { vm.TripPoll }, and alerts every { vm.AlertPoll }.</p>
			</article>
		</section>
	}
}
