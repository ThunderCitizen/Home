package pages

import (
	"fmt"
	"thundercitizen/internal/views"
	"thundercitizen/templates"
	"thundercitizen/templates/components"
)

templ Home(vm views.HomeViewModel) {
	@templates.Layout(templates.SocialMeta{
		Title:       "Home",
		Description: "Thunder Bay's civic data in one place — transit tracking, council votes, the budget and more.",
		OGImage:     "/static/og/home.png",
	}) {
		<div class="home">
		<section class="home-hero">
			<h1>{ vm.Hero.Title }</h1>
			<p class="lead">{ vm.Hero.Lead }</p>
			<p class="home-subtitle">{ vm.Hero.Subtitle }</p>
			@components.ThemePicker(components.ThemePickerProps{LabelID: "theme-picker-label"})
		</section>

		<section class="home-section">
			<h2>Explore</h2>
			<div class="grid cols-3">
				for _, link := range vm.QuickLinks {
					@components.LinkedCard(link)
				}
			</div>
		</section>

		<div class="home-bottom grid cols-2">
			@components.Card(components.CardProps{Title: "Notice Board"}) {
				<div class="notice-welcome">
					<div class="notice-item">
						<strong>Council minutes — upstream delay</strong>
						<time class="notice-date" datetime="2026-05-07">Posted May 7, 2026</time>
						<p>The latest minutes we&rsquo;ve processed are from March 17, 2026. Last we checked, minutes for the council meetings since haven&rsquo;t been posted on <a href="https://pub-thunderbay.escribemeetings.com/?Year=2026&amp;Expanded=City%20Council" target="_blank" rel="noopener">eSCRIBE</a> — though full meeting recordings are available there in the meantime.</p>
						<p>We check regularly and will process the official minutes as soon as they&rsquo;re posted.</p>
					</div>
					<div class="notice-item">
						<strong>Welcome</strong>
						<p>Inspired by <a href="https://justthemenu.ca" target="_blank" rel="noopener">Just The Menu</a>, we want to aggregate public data so people can be informed about their community.</p>
						<p>We&rsquo;re still getting set up. More data and features are coming soon.</p>
					</div>
				</div>
			}

			if len(vm.RecentMeetings) > 0 || len(vm.PendingMeetings) > 0 {
				@components.Card(components.CardProps{Title: "Recent Council Activity"}) {
					<div class="recent-meetings">
						for _, m := range vm.PendingMeetings {
							<div class="recent-meeting recent-meeting--pending">
								<div class="recent-meeting-header">
									<strong>{ m.Date }</strong>
								</div>
								if m.Summary != "" {
									<p class="recent-meeting-summary">{ m.Summary }</p>
								}
								if len(m.KeyItems) > 0 {
									<ul class="recent-meeting-items">
										for _, item := range m.KeyItems {
											<li>{ item }</li>
										}
									</ul>
								}
								<div class="recent-meeting-footer">
									if m.MinutesETA != "" {
										<span class="recent-meeting-eta">{ m.MinutesETA }</span>
									}
									<span class="recent-meeting-status">Minutes Pending</span>
								</div>
							</div>
						}
						for _, m := range vm.RecentMeetings {
							<div class="recent-meeting">
								<div class="recent-meeting-header">
									<a href={ templ.SafeURL(fmt.Sprintf("/minutes/%s", m.Slug)) }>
										<strong>{ m.Date }</strong>
									</a>
									<span class="recent-meeting-count">{ fmt.Sprintf("%d motions", m.Motions) }</span>
								</div>
								<p class="recent-meeting-summary">{ m.Summary }</p>
								<div class="recent-meeting-footer">
									<a href={ templ.SafeURL(fmt.Sprintf("/minutes/%s", m.Slug)) } class="meeting-row-btn">Minutes</a>
								</div>
							</div>
						}
					</div>
					<p class="recent-meetings-more"><a href="/minutes">View all meetings &rarr;</a></p>
				}
			}
		</div>
		</div>
	}
}
