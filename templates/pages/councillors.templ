package pages

import (
	"fmt"
	"strings"
	"thundercitizen/internal/models"
	"thundercitizen/internal/views"
	"thundercitizen/templates"
	"thundercitizen/templates/components"
)

// lastFirst reformats "Albert Aiello" as "Aiello, Albert" so the
// vote-matrix photo labels reveal the distinguishing surname first and
// truncate the given name when cramped. Middle tokens stay with the given.
func lastFirst(full string) string {
	parts := strings.Fields(full)
	if len(parts) < 2 {
		return full
	}
	last := parts[len(parts)-1]
	given := strings.Join(parts[:len(parts)-1], " ")
	return last + ", " + given
}

func statusBadgeClass(status string) string {
	if status != "" {
		return "badge-muted"
	}
	return ""
}

// wardCouncillorMap builds a {wardName: councillorName} lookup for the ward map's info bar.
func wardCouncillorMap(councillors []views.CouncillorView) map[string]string {
	out := make(map[string]string, len(councillors))
	for _, c := range councillors {
		out[c.Position] = c.Name
	}
	return out
}

func wardLayerGroups() []components.MapLayerGroup {
	return []components.MapLayerGroup{{
		Label: "Layers",
		Layers: []components.MapLayer{
			{Key: "wards", Label: "Wards", Active: true, Icon: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/></svg>`},
		},
	}}
}

// matrixColSpan returns the total number of columns (2 fixed + councillors) as a string.
// matrixColSpan returns the total column count (3 fixed + councillors) as a string.
func matrixColSpan(numRows int) string {
	return fmt.Sprintf("%d", numRows+3)
}

// matrixDateColSpan returns the colspan for date rows (total - 1 for the leading td).
func matrixDateColSpan(numRows int) string {
	return fmt.Sprintf("%d", numRows+1)
}

// splitMobileColumns slices the matrix columns into a head shown by default
// and a tail revealed by the "Show all" button. The split is at a column
// boundary, so date dividers naturally bound each group.
func splitMobileColumns(cols []views.VoteMatrixColumn, n int) ([]views.VoteMatrixColumn, []views.VoteMatrixColumn) {
	if len(cols) <= n {
		return cols, nil
	}
	return cols[:n], cols[n:]
}

// escribeRef is the canonical citation for council recorded votes — the city
// publishes all motion records on its eScribe meeting portal.
var escribeRef = models.SourceRef{
	URL:   "https://pub-thunderbay.escribemeetings.com",
	Label: "Thunder Bay eScribe minutes",
}

templ Councillors(vm views.CouncillorsViewModel) {
	@templates.Layout(templates.SocialMeta{
		Title:       "Councillors",
		Description: "Thunder Bay's 13 city councillors — profiles, voting records, and an interactive ward map.",
		OGImage:     "/static/og/councillors.png",
	}) {
		<div id="councillor-content">
			@CouncillorsPartial(vm)
		</div>

		@voteMatrixDetailScript()
		@voteMatrixPhotoSync()
	}
}

// CouncillorsPartial renders the content inside #councillor-content.
// Used by HTMX on term switch and by the full page on initial load.
templ CouncillorsPartial(vm views.CouncillorsViewModel) {
	<div class="councillor-sticky-area">
		@components.YearSelector(vm.TermSelector)
		@components.PageHeader(components.PageHeaderProps{Title: "2022–2026 Council"})
		@components.TermPanel(components.TermPanelProps{Title: "Council Structure", HeadingLevel: 2}) {
			<p class="compensation-lead">Thunder Bay's 13-member council: 1 mayor, 5 at-large, and 7 ward representatives.</p>
			@components.TermMetricGrid(components.TermMetricGridProps{Cols: 3}) {
				for _, item := range vm.CompensationStats.Items {
					@components.TermMetric(components.TermMetricProps{Value: item.Value, Label: item.Label, Note: item.Note, Tooltip: item.Tooltip})
				}
			}
		}

	@components.TermPanel(components.TermPanelProps{Title: "Members", Footer: components.SourceFooter(vm.Source), HeadingLevel: 2}) {
		<div class="councillor-grid">
			@councillorCard(vm.Mayor, "mayor")
			for _, c := range vm.AtLargeCouncillors {
				@councillorCard(c, "atlarge")
			}
			for _, c := range vm.WardCouncillors {
				@councillorCard(c, "ward")
			}
		</div>

	}

	if vm.VoteMatrix != nil && len(vm.VoteMatrix.Columns) > 0 {
		@components.TermPanel(components.TermPanelProps{Title: "Recorded Votes", Footer: components.SourceFooter(escribeRef), HeadingLevel: 2}) {
			@voteMatrix(vm.VoteMatrix)
		}
	}
	</div>

	<section class="ward-panel" aria-label="Ward map">
		<div class="terminal-map-header" id="ward-map-header">
			<span class="terminal-map-title">Ward Map</span>
			<span class="ward-panel-subtitle">7 wards · 1 mayor · 5 at-large</span>
			@components.MapLayerBar(wardLayerGroups())
			<div class="tmi-layer tmi-hover" data-layer="hover" aria-live="polite"></div>
			<div class="tmi-layer tmi-selection" data-layer="selection" aria-live="polite"></div>
		</div>
		@components.LeafletMap(components.MapProps{
			ID:        "ward-map",
			AriaLabel: "Map of Thunder Bay ward boundaries",
			Class:     "ward-map-wrap",
			Scripts:   []string{"/static/councillors/ward-colors.js", "/static/councillors/ward-map.js"},
		}) {
			@templ.JSONScript("ward-councillors", wardCouncillorMap(vm.WardCouncillors))
		}
	</section>
}

// councillorCardAvatar renders the photo or initials fallback at card size.
templ councillorCardAvatar(c views.CouncillorView) {
	if c.Photo != "" {
		<img class="councillor-card-photo" src={ c.Photo } alt={ c.Name }/>
	} else {
		<span class="councillor-card-avatar" aria-hidden="true">{ c.Initials }</span>
	}
}

// councillorCardStatus renders the optional status badge, as a source link
// when a URL is available.
templ councillorCardStatus(c views.CouncillorView) {
	if c.Status != "" {
		if c.StatusURL != "" {
			<a
				href={ templ.SafeURL(c.StatusURL) }
				class={ "badge", statusBadgeClass(c.Status) }
				target="_blank"
				rel="noopener"
				title="Source"
			>{ c.Status }</a>
		} else {
			<span class={ "badge", statusBadgeClass(c.Status) }>{ c.Status }</span>
		}
	}
}

templ councillorCard(c views.CouncillorView, kind string) {
	<article
		class="councillor-card"
		id={ c.ID }
		if kind == "ward" {
			data-ward={ c.Position }
		}
	>
		<div class="councillor-card-head">
			@councillorCardAvatar(c)
			<div class="councillor-card-id">
				<div class="councillor-card-rolerow">
					switch kind {
						case "mayor":
							<span class="badge badge-mayor councillor-card-role">Mayor</span>
						case "atlarge":
							<span class="badge badge-atlarge councillor-card-role">At-Large</span>
						default:
							<span class="badge councillor-ward-badge councillor-card-role">{ c.Position }</span>
					}
					if c.Term != "" {
						<span class={ "badge", c.TermClass }>{ c.Term }</span>
					}
				</div>
				<strong class="councillor-card-name">{ c.Name }</strong>
			</div>
		</div>
		<p class="councillor-bio">{ c.Summary }</p>
		{{ hasTitle := kind == "atlarge" && c.Position != "" }}
		if hasTitle || c.Status != "" || c.VoteStats != nil {
			<div class="councillor-card-foot">
				if hasTitle || c.Status != "" {
					<div class="councillor-card-badges">
						if hasTitle {
							<span class="badge">{ c.Position }</span>
						}
						@councillorCardStatus(c)
					</div>
				}
				@councillorVoteStats(c)
			</div>
		}
	</article>
}

templ councillorVoteStats(c views.CouncillorView) {
	if c.VoteStats != nil {
		<div class="councillor-votes">
			<p class="vote-summary">
				<span class="vote-summary-stat">{ c.VoteStats.ForCount } for</span> ·
				<span class="vote-summary-stat">{ c.VoteStats.AgainstCount } against</span> ·
				<span class="vote-summary-stat">{ c.VoteStats.AbsentCount } absent</span>
			</p>
		</div>
	}
}

templ voteMatrix(vm *views.VoteMatrixViewModel) {
	<div class="vote-matrix-desktop">
		@voteMatrixHeader(vm)
		<div class="vote-matrix-wrapper">
				<table class="vote-matrix">
					<caption class="sr-only">Councillor voting record on recorded votes</caption>
					<thead class="vote-matrix-sizing-head">
						@voteMatrixHeadRows(vm)
					</thead>
					<tbody>
						for colIdx, col := range vm.Columns {
							if colIdx == 0 || col.Date != vm.Columns[colIdx-1].Date {
								<tr class="vote-matrix-date-row">
									<td></td>
									<td colspan={ matrixDateColSpan(len(vm.Rows)) }>{ col.Date }</td>
								</tr>
							}
							<tr class="vote-matrix-row" data-motion-id={ fmt.Sprintf("%d", col.MotionID) } aria-expanded="false" tabindex="0">
								<td class="vote-matrix-result-cell">
									if col.Result == "Lost" || col.Result == "Tie" {
										<span class={ "vote-matrix-result-badge", "vote-matrix-result--" + strings.ToLower(col.Result) }>{ col.Result }</span>
									} else {
										<span class="vote-matrix-result-badge vote-matrix-result--carried">Carried</span>
									}
									if col.MediaURL != "" {
										<span class="vote-matrix-media-badge" title="Press coverage">TBNews</span>
									}
								</td>
								<th class="vote-matrix-motion" scope="row">
									{ col.Label }
								</th>
								for _, row := range vm.Rows {
									if row.Cells[colIdx] == "for" {
										<td class="vote-cell vote-cell-for" title={ row.Name + ": For" }><span class="sr-only">For</span></td>
									} else if row.Cells[colIdx] == "against" {
										<td class="vote-cell vote-cell-against" title={ row.Name + ": Against" }><span class="sr-only">Against</span></td>
									} else {
										<td class="vote-cell vote-cell-absent" title={ row.Name + ": Not recorded" }><span class="sr-only">Not recorded</span></td>
									}
								}
							</tr>
							<tr class="vote-matrix-detail" hidden>
								<td colspan={ matrixColSpan(len(vm.Rows)) }>
									<div class="vote-matrix-detail-inner">
										<div class={ "vote-matrix-detail-content", "vote-matrix-detail--" + strings.ToLower(col.Result) }>
											if col.Summary != "" {
												<p class="vote-matrix-detail-summary">{ col.Summary }</p>
											}
											<div class="vote-matrix-detail-actions">
												if col.MediaURL != "" {
													<a href={ templ.SafeURL(col.MediaURL) } target="_blank" rel="noopener" class="vote-matrix-detail-btn vote-matrix-detail-btn--media">
														TBNews <span class="ext-link-icon" aria-hidden="true"></span>
													</a>
												}
												<a href={ templ.SafeURL(col.URL) } class="vote-matrix-detail-btn vote-matrix-detail-btn--primary">
													View full minutes <span aria-hidden="true">&rarr;</span>
												</a>
											</div>
										</div>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
	</div>
	@voteMatrixMobile(vm)
}

templ voteMatrixMobile(vm *views.VoteMatrixViewModel) {
	{{ visible, overflow := splitMobileColumns(vm.Columns, vm.MobileVisibleCount) }}
	<div class="vote-matrix-mobile">
		@mobileMatrixGroup(visible)
		if len(overflow) > 0 {
			<div class="vote-matrix-mobile-rest" hidden>
				<div class="vote-matrix-mobile-rest-inner">
					@mobileMatrixGroup(overflow)
				</div>
			</div>
			<button type="button" class="vote-matrix-show-all" aria-expanded="false">
				Show all { fmt.Sprintf("%d", len(overflow)) } more
			</button>
		}
	</div>
}

// mobileMatrixGroup renders a contiguous slice of columns with date dividers
// inserted at date transitions. The first card in the slice always emits its
// divider so the visible / overflow groups stay self-contained.
templ mobileMatrixGroup(cols []views.VoteMatrixColumn) {
	for i, col := range cols {
		if i == 0 || col.Date != cols[i-1].Date {
			<div class="vote-matrix-mobile-date">{ col.Date }</div>
		}
		<div class="vote-matrix-card" data-motion-id={ fmt.Sprintf("%d", col.MotionID) }>
			<div class="vote-matrix-card-top">
				<h3 class="vote-matrix-card-label">{ col.Label }</h3>
				if col.Roster != nil {
					<div class={ "vote-matrix-card-subtitle", "vote-matrix-card-subtitle--" + col.Roster.HeadlineCls }>
						<span class="vote-matrix-card-subtitle-headline">{ col.Roster.Headline }</span>
						<span class="vote-matrix-card-subtitle-tally">{ col.Roster.Tally }</span>
					</div>
				}
			</div>
			if col.Summary != "" && col.Summary != col.Label {
				<p class="vote-matrix-card-summary">{ col.Summary }</p>
			}
			if col.Roster != nil {
				<div class="vote-matrix-card-roster">
					{{ r := *col.Roster; r.OmitHeadline = true }}
					@components.VoteRoster(r)
				</div>
			}
			if col.MediaURL != "" {
				<div class="vote-matrix-card-footer">
					<a href={ templ.SafeURL(col.MediaURL) } target="_blank" rel="noopener" class="badge badge-media vote-matrix-card-media-link">
						TBNews <span class="ext-link-icon" aria-hidden="true"></span>
					</a>
				</div>
			}
		</div>
	}
}

templ voteMatrixNamesRow(vm *views.VoteMatrixViewModel) {
	<tr class="vote-matrix-names">
		<th class="vote-matrix-label"></th>
		<th class="vote-matrix-label"></th>
		for _, row := range vm.Rows {
			<th class="vote-matrix-councillor">
				<span title={ row.Name }>{ lastFirst(row.Name) }</span>
			</th>
		}
	</tr>
}

templ voteMatrixPhotosRow(vm *views.VoteMatrixViewModel) {
	<tr class="vote-matrix-photos">
		<td class="vote-matrix-label"></td>
		<td class="vote-matrix-label"></td>
		for _, row := range vm.Rows {
			<td class="vote-matrix-photo-cell">
				<span class="photo-tip" title={ row.Name } tabindex="0">
					if row.Photo != "" {
						<img class="vote-matrix-avatar" src={ row.Photo } alt={ row.Name }/>
					} else {
						<span class="vote-matrix-initials">{ row.Initials }</span>
					}
				</span>
			</td>
		}
	</tr>
}

// Shared rows for the sizing thead (hidden, sets column widths)
templ voteMatrixHeadRows(vm *views.VoteMatrixViewModel) {
	@voteMatrixNamesRow(vm)
	@voteMatrixPhotosRow(vm)
}

templ voteMatrixHeader(vm *views.VoteMatrixViewModel) {
	<div class="vote-matrix-sticky-header">
		<div class="vote-matrix-sticky-scroll">
			<table class="vote-matrix">
				@voteMatrixNamesRow(vm)
				@voteMatrixPhotosRow(vm)
			</table>
		</div>
	</div>
}

// voteMatrixDetailScript wires the desktop accordion (one row open at a time)
// and the mobile "Show all" reveal. Document-level delegation survives HTMX swaps.
templ voteMatrixDetailScript() {
	<script>
	(function() {
		var openRow = null;

		function setOpen(row, open) {
			row.setAttribute('aria-expanded', open ? 'true' : 'false');
			var detail = row.nextElementSibling;
			if (!detail || !detail.classList.contains('vote-matrix-detail')) return;
			if (open) {
				detail.removeAttribute('hidden');
				// next frame so the transition has a starting state to animate from
				requestAnimationFrame(function() {
					requestAnimationFrame(function() { detail.classList.add('is-open'); });
				});
			} else {
				detail.classList.remove('is-open');
				var inner = detail.querySelector('.vote-matrix-detail-inner');
				if (!inner) { detail.setAttribute('hidden', ''); return; }
				inner.addEventListener('transitionend', function handler() {
					inner.removeEventListener('transitionend', handler);
					if (!detail.classList.contains('is-open')) detail.setAttribute('hidden', '');
				}, { once: true });
			}
		}

		document.addEventListener('click', function(e) {
			// Show-all check first — the button itself would trip the a/button bail-out below.
			var showAll = e.target.closest('.vote-matrix-show-all');
			if (showAll) {
				var wrap = showAll.closest('.vote-matrix-mobile');
				var rest = wrap && wrap.querySelector('.vote-matrix-mobile-rest');
				if (rest) {
					rest.removeAttribute('hidden');
					requestAnimationFrame(function() {
						requestAnimationFrame(function() { rest.classList.add('is-open'); });
					});
				}
				showAll.setAttribute('hidden', '');
				return;
			}

			// Don't intercept clicks on links inside a row (e.g. action buttons).
			if (e.target.closest('a, button')) return;

			var row = e.target.closest('.vote-matrix-row');
			if (row) {
				if (openRow && openRow !== row) setOpen(openRow, false);
				var willOpen = row.getAttribute('aria-expanded') !== 'true';
				setOpen(row, willOpen);
				openRow = willOpen ? row : null;
			}
		});

		document.addEventListener('keydown', function(e) {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			var row = e.target.closest('.vote-matrix-row');
			if (!row) return;
			e.preventDefault();
			row.click();
		});
	})();
	</script>
}

templ voteMatrixPhotoSync() {
	<script>
	(function() {
		var scrollWired = false;

		// Copy column widths from a data row onto the sticky header rows.
		// Idempotent — safe to call on every resize.
		function syncWidths() {
			var w = document.querySelector('.vote-matrix-wrapper');
			var s = document.querySelector('.vote-matrix-sticky-scroll');
			if (!w || !s) return;
			var dataRows = w.querySelectorAll('tbody tr.vote-matrix-row');
			var dr = dataRows.length > 0 ? dataRows[0] : null;
			if (dr) {
				s.querySelectorAll('tr').forEach(function(pr) {
					for (var i = 0; i < dr.children.length && i < pr.children.length; i++)
						pr.children[i].style.width = dr.children[i].offsetWidth + 'px';
				});
			}
			var thead = w.querySelector('.vote-matrix-sizing-head');
			if (thead) thead.style.visibility = 'collapse';
		}

		// Wire the horizontal-scroll mirror exactly once (listener would
		// otherwise stack on every sync/resize call).
		function wireScroll() {
			if (scrollWired) return;
			var w = document.querySelector('.vote-matrix-wrapper');
			var s = document.querySelector('.vote-matrix-sticky-scroll');
			if (!w || !s) return;
			scrollWired = true;
			var ticking = false;
			w.addEventListener('scroll', function() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(function() {
					s.scrollLeft = w.scrollLeft;
					ticking = false;
				});
			}, { passive: true });
		}

		function sync() {
			syncWidths();
			wireScroll();
		}

		sync();
		document.body.addEventListener('htmx:afterSwap', function() {
			scrollWired = false; // wrapper element is replaced by the swap
			sync();
		});

		// Re-measure on resize — the data table reflows fluidly but the
		// sticky header's px widths are frozen until we recopy them.
		var rt;
		window.addEventListener('resize', function() {
			clearTimeout(rt);
			rt = setTimeout(syncWidths, 80);
		}, { passive: true });
	})();
	</script>
}
