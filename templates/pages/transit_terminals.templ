package pages

import (
	"thundercitizen/internal/assets"
	"thundercitizen/internal/transit"
	"thundercitizen/templates"
	"thundercitizen/templates/components"
)

// TransitTerminals renders the all-in-one terminal departures view.
// One page, four tabs at the top, the active terminal's board fills
// everything below. Designed first for big-screen displays and second
// for desktop browsing — every dimension scales fluidly via clamp/vw
// so the same markup works on a 1080p TV and a laptop.
templ TransitTerminals(vm transit.TerminalsViewModel) {
	@templates.Layout(templates.SocialMeta{
		Title:       "Terminals",
		Description: "Live next-bus departures for every Thunder Bay Transit terminal — Waterfront, City Hall, College, and Lakehead University.",
		OGImage:     "/static/og/transit.png",
	}) {
		@components.TransitNav(components.TransitNavProps{Current: "terminals"})

		@templ.JSONScript("route-meta", vm.RouteMeta)
		<script src={ assets.URL("/static/transit/route-meta.js") }></script>

		<section class="terminal-board-page" aria-label="Terminal departures boards">
			@components.TerminalMapHeader(vm.Terminals, 0)

			<main class="terminal-board" id="terminal-board" data-stop-id={ vm.Terminals[0].StopID } data-stop-name={ vm.Terminals[0].StopName } data-poll-ms="15000">
				<header class="terminal-board-head">
					<h1 class="terminal-board-name" id="board-stop-name">{ vm.Terminals[0].StopName }</h1>
					<span class="terminal-board-clock-fs" id="board-clock-fs" aria-hidden="true"></span>
					<span id="board-updated" class="terminal-board-updated"></span>
				</header>
				<section class="terminal-board-body-area" aria-label="Next departures">
					<div id="board-rows" class="terminal-card-grid" aria-live="polite">
						<div class="terminal-board-empty" id="board-empty">Waiting for first feed…</div>
					</div>
				</section>
			</main>
		</section>

		<script src={ assets.URL("/static/transit/terminal-board.js") }></script>
	}
}
