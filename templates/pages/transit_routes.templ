package pages

import (
	"thundercitizen/internal/transit"
	"thundercitizen/templates"
	"thundercitizen/templates/components"
	"time"
)

func routeDayLabel(iso string) string {
	day, err := time.Parse("2006-01-02", iso)
	if err != nil {
		return iso
	}
	return day.Format("Monday, January 2, 2006")
}

func routeMetricUnit(value, unit string) string {
	if value == "" || value == "—" {
		return "—"
	}
	return value + unit
}

templ routeDayNav(dr transit.DateRange) {
	<form class="route-date-nav" method="get" aria-label="Choose service day" hx-get="/transit/routes" hx-trigger="change" hx-target="#route-day-panel" hx-swap="outerHTML focus-scroll:false" hx-push-url="true" hx-sync="#route-day-panel:replace">
		if dr.From > dr.MinDate {
			<a id="route-previous-day" href={ templ.SafeURL("?date=" + weekShift(dr.From, -1)) } hx-get={ "/transit/routes?date=" + weekShift(dr.From, -1) } hx-target="#route-day-panel" hx-swap="outerHTML focus-scroll:false" hx-push-url="true" hx-sync="#route-day-panel:replace" aria-label="Previous day">&lsaquo;</a>
		} else {
			<span aria-disabled="true" aria-label="Previous day">&lsaquo;</span>
		}
		<input id="route-service-date" type="date" name="date" value={ dr.From } min={ dr.MinDate } max={ dr.MaxDate } aria-label="Service date" required/>
		if dr.From < dr.MaxDate {
			<a id="route-next-day" href={ templ.SafeURL("?date=" + weekShift(dr.From, 1)) } hx-get={ "/transit/routes?date=" + weekShift(dr.From, 1) } hx-target="#route-day-panel" hx-swap="outerHTML focus-scroll:false" hx-push-url="true" hx-sync="#route-day-panel:replace" aria-label="Next day">&rsaquo;</a>
		} else {
			<span aria-disabled="true" aria-label="Next day">&rsaquo;</span>
		}
	</form>
}

templ routeDayNote(date string) {
	if date == transit.ServiceDate().Format("2006-01-02") {
		<p class="metrics-trend-intro">Today’s figures are in progress and update as observations are processed.</p>
	}
}

templ TransitRoutes(vm transit.RoutesViewModel) {
	@templates.Layout(templates.SocialMeta{
		Title:       "Transit — Routes",
		Description: "Thunder Bay Transit routes — daily trips, reported cancellations and on-time performance.",
		OGImage:     "/static/og/transit.png",
	}) {
		@components.TransitNav(components.TransitNavProps{Current: "routes"})
		@components.PageHeader(components.PageHeaderProps{Title: "Route Directory"})
		@TransitRoutesDay(vm)
	}
}

templ TransitRoutesDay(vm transit.RoutesViewModel) {
	<section id="route-day-panel" class="metrics-panel" aria-label="Daily route summaries">
		<div class="terminal-map-header metrics-panel-header">
			<h2 class="terminal-map-title route-day-heading">
				<span>All Routes</span>
				<time datetime={ vm.Range.From }>{ routeDayLabel(vm.Range.From) }</time>
			</h2>
			<div class="metrics-header-controls">
				@routeDayNav(vm.Range)
			</div>
		</div>
		<dl class="route-day-totals" aria-label="All route totals for the selected day">
			<div><dt>Total trips</dt><dd>{ vm.Totals.Trips }</dd></div>
			<div><dt>Total cancelled</dt><dd>{ vm.Totals.Cancelled }</dd></div>
			<div><dt>% cancelled</dt><dd>{ vm.Totals.CancelPct }</dd></div>
		</dl>
		@routeDayNote(vm.Range.From)
		<div class="route-legend route-directory-grid">
			for _, rt := range vm.RouteMeta {
				{{ kpi := vm.Summaries[rt.RouteID].CardStats() }}
				@routeCard(rt, false, false, []routeCardField{
					{Value: valOrDash(kpi.Trips), Label: "trips"},
					{Value: valOrDash(kpi.Cancel), Label: "cancel"},
					{Value: routeMetricUnit(kpi.OTP, "%"), Label: "OTP"},
				})
			}
		</div>
		if len(vm.RouteMeta) == 0 {
			<p class="metrics-trend-intro">No routes are available for this day.</p>
		}
		<p class="metrics-trend-intro">Service day: 4 a.m. to 4 a.m. Thunder Bay local time.</p>
		<p class="metrics-trend-intro">Trips and cancellations reflect available feed reports. OTP means on-time performance; — means unavailable. <a href="/transit/method">How we calculate these figures</a>.</p>
	</section>
}
