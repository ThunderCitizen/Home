package pages

import "thundercitizen/templates"

templ ServiceUnavailable() {
	@templates.Layout(templates.SocialMeta{
		Title:       "Service Unavailable",
		Description: "Database connection unavailable.",
	}) {
		<section class="nf-hero">
			<!-- Database cylinder — offline -->
			<svg class="ua-art" viewBox="0 0 160 160" fill="none" aria-hidden="true">
				<!-- ── Cylinder body ── -->
				<!-- Left and right walls -->
				<line x1="38" y1="38" x2="38" y2="112" stroke="currentColor" stroke-width="1.5"/>
				<line x1="122" y1="38" x2="122" y2="112" stroke="currentColor" stroke-width="1.5"/>

				<!-- Top cap — full ellipse (visible rim) -->
				<ellipse cx="80" cy="38" rx="42" ry="13" stroke="currentColor" stroke-width="1.5"/>

				<!-- Tier 1 divider — front arc only (lower half of ellipse at y=63) -->
				<path d="M38 63 A42 13 0 0 0 122 63" stroke="currentColor" stroke-width="1" opacity="0.65"/>

				<!-- Tier 2 divider — front arc at y=88 -->
				<path d="M38 88 A42 13 0 0 0 122 88" stroke="currentColor" stroke-width="1" opacity="0.65"/>

				<!-- Bottom cap — full ellipse -->
				<ellipse cx="80" cy="112" rx="42" ry="13" stroke="currentColor" stroke-width="1.5"/>

				<!-- ── Storage grooves on cylinder face (subtle) ── -->
				<line x1="52" y1="49" x2="108" y2="49" stroke="currentColor" stroke-width="0.5" opacity="0.25" stroke-dasharray="3 3"/>
				<line x1="50" y1="75" x2="110" y2="75" stroke="currentColor" stroke-width="0.5" opacity="0.25" stroke-dasharray="3 3"/>
				<line x1="50" y1="100" x2="110" y2="100" stroke="currentColor" stroke-width="0.5" opacity="0.25" stroke-dasharray="3 3"/>

				<!-- ── Status LEDs on mid tier — all dark/off ── -->
				<circle cx="65" cy="76" r="3" stroke="currentColor" stroke-width="1" opacity="0.45"/>
				<circle cx="80" cy="76" r="3" stroke="currentColor" stroke-width="1" opacity="0.45"/>
				<circle cx="95" cy="76" r="3" stroke="currentColor" stroke-width="1" opacity="0.45"/>
				<!-- X marks through each LED to show no signal -->
				<line x1="63" y1="74" x2="67" y2="78" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
				<line x1="67" y1="74" x2="63" y2="78" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
				<line x1="78" y1="74" x2="82" y2="78" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
				<line x1="82" y1="74" x2="78" y2="78" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
				<line x1="93" y1="74" x2="97" y2="78" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
				<line x1="97" y1="74" x2="93" y2="78" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>

				<!-- ── Offline badge — top right corner ── -->
				<circle cx="116" cy="22" r="11" stroke="currentColor" stroke-width="1.2"/>
				<!-- X inside badge -->
				<line x1="110" y1="16" x2="122" y2="28" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
				<line x1="122" y1="16" x2="110" y2="28" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

				<!-- ── Disconnected cable hanging below ── -->
				<!-- Cable stub out of bottom -->
				<line x1="80" y1="125" x2="80" y2="137" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
				<!-- Break / spark -->
				<path d="M76 137 L84 141 L76 145 L84 149" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" opacity="0.75"/>
				<!-- Cable end (frayed) -->
				<line x1="72" y1="149" x2="76" y2="152" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
				<line x1="80" y1="150" x2="80" y2="154" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.5"/>
				<line x1="88" y1="149" x2="84" y2="152" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.5"/>

				<!-- Floor line -->
				<line x1="4" y1="156" x2="156" y2="156" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
			</svg>

			<div class="nf-hero-text">
				<h1>
					<span class="nf-404">503</span>
					<code class="ua-label">database unavailable</code>
				</h1>
				<p>The database is unreachable. All data-driven pages are offline until the connection is restored.</p>
				<p style="margin-top:0.5rem"><a href="javascript:location.reload()" class="ua-retry">retry</a></p>
			</div>
		</section>

		<!--
		    ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
		    ░  motion #503:              ░
		    ░  that the database         ░
		    ░  reconnect immediately     ░
		    ░  moved:    nobody          ░
		    ░  seconded: nobody          ░
		    ░  result:   connection lost ░
		    ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
		-->
	}
}
