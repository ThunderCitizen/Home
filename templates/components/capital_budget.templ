func capitalProjectSectionTag(project CapitalProjectItem) string {
	return capitalProjectPublicSection(project)
}

func capitalProjectSectionRollup(project CapitalProjectItem) string {
	return capitalProjectRollupForTag(capitalProjectSectionTag(project))
}

func capitalProjectRollupForTag(tag string) string {
	switch strings.ToLower(strings.TrimSpace(tag)) {
	case "roads":
		return "Roads"
	case "water", "wastewater", "stormwater":
		return "Water & Wastewater"
	case "waste":
		return "Waste"
	case "buildings", "parks", "recreation", "housing":
		return "Public Places"
	case "fleet", "equipment":
		return "Vehicles & Gear"
	case "fire", "police", "ems":
		return "Emergency"
	case "transit":
		return "Transit"
	case "parking":
		return "Parking"
	case "tech", "studies", "civic":
		return "Digital & Planning"
	default:
		return "Other"
	}
}

func capitalProjectPublicSection(project CapitalProjectItem) string {
	id := strings.ToLower(project.ID)
	name := strings.ToLower(project.Name)
	service := strings.ToLower(project.Service)
	category := strings.ToLower(project.Category)
	text := strings.Join([]string{id, name, service, category}, " ")
	switch {
	case strings.Contains(id, "-ems-") || strings.Contains(name, "ambulance") || strings.Contains(name, "medical equipment") || strings.Contains(name, "superior north ems"):
		return "EMS"
	case strings.Contains(id, "-fir-") || strings.Contains(service, "fire") || strings.Contains(category, "fire") || containsAny(text, "fire hall", "pumper", "aerial ladder", "fire hose", "auto extrication"):
		return "Fire"
	case strings.Contains(id, "-pol-") || strings.Contains(service, "police") || containsAny(text, "police", "armoury", "body worn", "forensics", "cyber crime", "uniform patrol"):
		return "Police"
	case strings.Contains(id, "-trn-") || containsAny(text, "transit", "bus wash", "shelter", "accessible stop", "terminal realignment"):
		return "Transit"
	case strings.Contains(id, "-pkg-") || containsAny(text, "parking", "parkade", "parking meters"):
		return "Parking"
	case strings.Contains(id, "waw") || strings.Contains(service, "waterworks") || containsAny(text, "watermain", "water fill", "water meter", "lead service", "lead reduction", "hydrant", "valves", "cathodic", "wtp", "reservoir", "pump station"):
		return "Water"
	case strings.Contains(id, "san") || strings.Contains(service, "wastewater") || containsAny(text, "sanitary", "sewage", "wpcp", "wastewater"):
		return "Wastewater"
	case strings.Contains(service, "stormwater") || containsAny(text, "stormwater", "storm sewer", "drainage", "outfall", "trunk ditch", "low impact development"):
		return "Stormwater"
	case strings.Contains(service, "solid waste") || strings.Contains(service, "landfill") || strings.Contains(id, "sow") || containsAny(text, "landfill", "organics", "solid waste", "litter", "cell capping", "gas system"):
		return "Waste"
	case strings.Contains(service, "housing") || strings.Contains(service, "child care") || containsAny(text, "housing", "residential", "jasper furnishings", "food delivery"):
		return "Housing"
	case strings.Contains(id, "pks") || containsAny(text, "park", "playground", "trail", "golf", "urban forest", "tree planting", "forestry", "public art", "boater"):
		return "Parks"
	case containsAny(service, "arenas", "aquatics", "community and cultural", "public library") || containsAny(text, "arena", "stadia", "aquatics", "community centre", "older adult", "canada games", "ice resurfacer", "stage equipment", "library", "tourism"):
		return "Recreation"
	case containsAny(category, "professional fees", "plans and studies", "engineering") || containsAny(text, "study", "studies", "design", "assessment", "audit", "strategy", "planning", "pre-engineering", "property acquisition", "aerial photography", "orthophotography"):
		return "Studies"
	case strings.Contains(service, "roads") || strings.Contains(service, "bridges") || strings.Contains(service, "active transportation") || strings.Contains(id, "rds") || containsAny(text, "road", "bridge", "culvert", "sidewalk", "signal", "street lighting", "pavement", "asphalt", "traffic", "railway crossing", "arterial", "guardrail", "retaining wall"):
		return "Roads"
	case containsAny(category, "technology") || containsAny(text, "digital", "software", "network & software", "payroll", "crm", "website", "digitization"):
		return "Tech"
	case containsAny(category, "facilities") || containsAny(text, "facility", "facilities", "building", "office", "whalen", "security", "energy efficiency", "lighting upgrades"):
		return "Buildings"
	case containsAny(category, "fleet") || containsAny(text, "fleet", "vehicle", "vehicles"):
		return "Fleet"
	case containsAny(category, "equipment") || strings.Contains(name, "equipment"):
		return "Equipment"
	case strings.Contains(service, "initiatives and support") || containsAny(category, "initiatives and support") || containsAny(text, "beautification", "civic pride", "growth project", "customer service"):
		return "Civic"
	default:
		return "Other"
	}
}

func containsAny(value string, needles ...string) bool {
	for _, needle := range needles {
		if strings.Contains(value, needle) {
			return true
		}
	}
	return false
}

func capitalProjectCategoryFamily(category string) string {
	category = strings.TrimSpace(category)
	if category == "" {
		return ""
	}
	for _, sep := range []string{" (", " - "} {
		if idx := strings.Index(category, sep); idx > 0 {
			return strings.TrimSpace(category[:idx])
		}
	}
	return capitalProjectSectionDisplayName(category)
}

func capitalProjectSectionTitle(project CapitalProjectItem) string {
	if project.Category != "" {
		return project.Category
	}
	return project.Service
}

func capitalProjectSectionOfficialName(project CapitalProjectItem) string {
	return capitalProjectRollupDescription(capitalProjectSectionRollup(project))
}

func capitalProjectRollupDescription(section string) string {
	switch strings.ToLower(strings.TrimSpace(section)) {
	case "all":
		return "All tracked capital projects"
	case "infrastructure":
		return "Roads, water, wastewater, stormwater, and waste systems"
	case "roads":
		return "Roads, bridges, sidewalks, signals, and street lighting"
	case "water & wastewater":
		return "Water, wastewater, and stormwater systems"
	case "waste":
		return "Landfill, organics, solid waste facilities, and waste fleet"
	case "public places":
		return "Buildings, parks, recreation, and housing projects"
	case "vehicles & gear":
		return "Fleet, vehicles, tools, and equipment"
	case "emergency":
		return "Fire, police, and emergency medical services"
	case "transit":
		return "Transit facilities, shelters, stops, buses, and service equipment"
	case "parking":
		return "Parking meters and parkade repairs"
	case "digital & planning":
		return "Technology, studies, plans, and civic support projects"
	default:
		return strings.TrimSpace(section)
	}
}

