func capitalProjectSectionDisplayName(section string) string {
	switch strings.ToLower(strings.TrimSpace(section)) {
	case "professional fees, plans and studies":
		return "Studies"
	case "active transportation and traffic infrastructure":
		return "Mobility"
	case "thunder bay fire rescue":
		return "Fire"
	case "transit services":
		return "Transit"
	case "technology":
		return "Tech"
	case "superior north ems":
		return "EMS"
	case "municipal offices and facilities":
		return "Municipal"
	case "initiatives and support":
		return "Support"
	default:
		return strings.TrimSpace(section)
	}
}

func capitalProjectCategoryTag(project CapitalProjectItem) string {
	category := strings.ToLower(strings.TrimSpace(project.Category))
	service := strings.ToLower(strings.TrimSpace(project.Service))
	switch {
	case strings.Contains(category, "system maintenance") || strings.Contains(category, "system maintenence"):
		return "Maintenance"
	case strings.Contains(category, "advanced metering"):
		return "Metering"
	case strings.Contains(category, "renewal") || strings.Contains(category, "rehabilitation") || strings.Contains(category, "replacement") || strings.Contains(category, "preservation"):
		return "Renewal"
	case strings.Contains(category, "watermain") || strings.Contains(category, "waterworks") || strings.Contains(category, "water") || strings.Contains(service, "waterworks"):
		return "Water"
	case strings.Contains(category, "sanitary") || strings.Contains(category, "wastewater") || strings.Contains(service, "wastewater"):
		return "Wastewater"
	case strings.Contains(category, "stormwater") || strings.Contains(service, "stormwater"):
		return "Stormwater"
	case strings.Contains(category, "fleet") || strings.Contains(category, "vehicle") || strings.Contains(service, "fleet"):
		return "Fleet"
	case strings.Contains(category, "forestry"):
		return "Forestry"
	case strings.Contains(category, "park") || strings.Contains(category, "trail") || strings.Contains(category, "playground") || strings.Contains(category, "sports") || strings.Contains(category, "boater") || strings.Contains(service, "parks"):
		return "Parks"
	case strings.Contains(category, "street lighting"):
		return "Lighting"
	case strings.Contains(category, "sidewalk") || strings.Contains(category, "traffic") || strings.Contains(category, "active transportation"):
		return "Mobility"
	case strings.Contains(category, "bridge") || strings.Contains(category, "culvert") || strings.Contains(category, "road") || strings.Contains(category, "guardrail") || strings.Contains(category, "retaining wall") || strings.Contains(service, "bridge") || strings.Contains(service, "culvert") || strings.Contains(service, "road") || category == "network":
		return "Roads"
	case strings.Contains(category, "facility") || strings.Contains(category, "building") || strings.Contains(category, "arena") || strings.Contains(category, "library") || strings.Contains(service, "arena") || strings.Contains(service, "library") || strings.Contains(service, "municipal offices") || strings.Contains(service, "cultural") || strings.Contains(service, "child care") || strings.Contains(service, "long-term care"):
		return "Facilities"
	case strings.Contains(category, "equipment") || strings.Contains(category, "technology") || strings.Contains(service, "police") || strings.Contains(service, "fire"):
		return "Equipment"
	case strings.Contains(category, "superior north ems") || strings.Contains(service, "ems"):
		return "EMS"
	case strings.Contains(service, "housing"):
		return "Housing"
	case strings.Contains(service, "transit"):
		return "Transit"
	case strings.Contains(service, "solid waste") || strings.Contains(service, "landfill"):
		return "Waste"
	case strings.Contains(service, "parking"):
		return "Parking"
	case strings.Contains(category, "professional fees") || strings.Contains(category, "plans") || strings.Contains(category, "studies") || strings.Contains(category, "engineering") || strings.Contains(category, "programs") || strings.Contains(category, "initiatives") || strings.Contains(service, "engineering") || strings.Contains(service, "initiatives"):
		return "Planning"
	}
	return "Other"
}
